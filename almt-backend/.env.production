# ALMT 生产环境配置（云服务器）
# 与 ALMD/IALMD 共用同一 MySQL 账号（almd/Almd@2026）
# 注：@ 在 URL 中需用 %40 编码，避免被某些解析器当成注释

APP_NAME=经营计划模拟系统
APP_VERSION=1.0.0
DEBUG=false

# 服务器配置（127.0.0.1 仅 nginx 访问，端口 8001）
HOST=127.0.0.1
PORT=8001

# MySQL 配置（URL 编码：Almd@2026 → Almd%402026）
DATABASE_URL_OVERRIDE=mysql+pymysql://almd:Almd%402026@127.0.0.1:3306/almt_db?charset=utf8mb4

# Redis（暂未启用，almt_app 未实际使用）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# JWT
SECRET_KEY=almt-production-secret-key-replace-in-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Excel 模型路径（缺文件时优雅降级）
EXCEL_MODEL_PATH=./models/ALMTCalculateEngine.xlsm
EXCEL_DATA_PATH=./data
